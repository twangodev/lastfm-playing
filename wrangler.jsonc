{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastfm-playing",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-24",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
  "ratelimits": [
    {
      "name": "LASTFM_RATE_LIMITER",
      "namespace_id": "1789500001",
      "simple": {
        "limit": 5,
        "period": 10,
      },
    },
  ],
  "vars": {
    "ALLOWED_USERS": "*",
    "CORS_ORIGIN": "*",
    "CACHE_TTL": "30",
  },
}
